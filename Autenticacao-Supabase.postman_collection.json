{
  "info": {
    "_postman_id": "d649210b-f54e-440b-8327-9588f05c63c6",
    "name": "Testes de Autenticação - Supabase",
    "description": "Testes caixa cinza para autenticação por e-mail e senha no Supabase. Configure o Environment antes de executar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "60029014",
    "_collection_link": "https://go.postman.co/collection/60029014-d649210b-f54e-440b-8327-9588f05c63c6?source=collection_link"
  },
  "item": [
    {
      "name": "01 - Login válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login válido retorna HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Resposta contém access_token', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.have.property('access_token');",
              "  pm.expect(data.access_token).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Use o e-mail e a senha corretos do usuário criado no Supabase."
      },
      "response": []
    },
    {
      "name": "02 - Senha incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Senha incorreta não autentica', function () { pm.expect(pm.response.code).to.not.equal(200); });",
              "pm.test('Resposta apresenta erro', function () {",
              "  const data = pm.response.json();",
              "  pm.expect(data).to.have.property('error');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{api_key}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{wrong_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        },
        "description": "Use o e-mail válido e uma senha deliberadamente incorreta."
      },
      "response": []
    },
